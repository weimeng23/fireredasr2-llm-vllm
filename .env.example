# 复制为 .env 后使用：docker run --env-file .env ...
# GPU、宿主机模型目录和端口映射仍通过 docker run 参数指定。

# ── 启动与通用配置 ──
# vllm：直接运行 vLLM；all：运行网关 + vLLM。
SERVICE_MODE=vllm
# 对外 API 密钥；两种模式均使用，留空表示不启用鉴权。
ASR_API_KEY=
# 以下两个超时用于 all 模式的进程管理，单位秒。
# 等待 vLLM 就绪的最长时间。
STARTUP_TIMEOUT_SECONDS=900
# 停止服务的清理宽限期；docker --stop-timeout 应大于此值。
SHUTDOWN_TIMEOUT_SECONDS=25

# ── vLLM 配置：两种模式均生效，由启动脚本转换为 vLLM 参数 ──
# 容器内模型路径。
MODEL_PATH=/models/fireredasr2
# 模型精度与显存预算比例。
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.85
# 单次推理的总上下文 token 上限，不是音频秒数。
MAX_MODEL_LEN=4096
# vLLM 每轮调度的序列上限，不是网关文件数或 HTTP 请求数上限。
MAX_NUM_SEQS=8
# vLLM 每轮处理的 token 预算。
MAX_NUM_BATCHED_TOKENS=4096
# vLLM 等待和运行中的请求总数上限；达到后拒绝新请求。
MAX_NUM_QUEUED_REQS=64
# 设为 1 关闭 CUDA Graph，使用 eager 执行。
ENFORCE_EAGER=0
# 多模态预处理缓存大小，单位 GiB；0 表示关闭。
MM_PROCESSOR_CACHE_GB=0

# ── 网关配置：仅 SERVICE_MODE=all 生效 ──
# 音频切片与 VAD。最长片段时长（秒），必须大于 0 且不超过 30。
CHUNK_SECONDS=25
# WebRTC VAD 使用 CPU；设为 0 保留全部音频，仍按最长片段时长切分。
VAD_ENABLED=1
# 0–3，数值越大越倾向判为非语音。
VAD_MODE=1
# VAD 帧长：10 / 20 / 30 毫秒。
VAD_FRAME_MS=20
# 连续静音断句阈值、语音前后保留时长，单位毫秒。
VAD_SILENCE_MS=500
VAD_PADDING_MS=200

# 上传限制：每个 HTTP 请求中所有音频的合计大小，单位 MiB。
MAX_UPLOAD_MB=256
# 每个 HTTP 请求最多上传的音频条数，超限拒绝整个请求。
MAX_BATCH_FILES=32
# 每条音频的最长时长，单位秒。
MAX_AUDIO_SECONDS=3600

# 网关预留的文件处理名额总数，涵盖校验、VAD、分段和识别。
# 批内文件超出名额时等待；无空闲名额时新 HTTP 请求返回 429。
# 当前实现中，预留名额在整个批次结束后统一释放。
MAX_ACTIVE_JOBS=8
# 网关同时执行的片段识别数（含切片和等待 vLLM 响应）。
# 槽位满时已接纳的任务等待；此值不是 vLLM 自身的容量上限。
BACKEND_CONCURRENCY=8
# 网关调用 vLLM 的 HTTP 超时，单位秒；不包含等待并发槽位的时间。
BACKEND_TIMEOUT_SECONDS=120
# 网关为每个片段请求设置的输出 token 上限，不影响直连 vLLM 请求。
MAX_COMPLETION_TOKENS=512
# 网关 VAD 检测超时，单位秒。
MEDIA_TIMEOUT_SECONDS=180
