# Optional: docker run --env-file .env ...
# GPU, host model path and port mappings are docker run arguments.
SERVICE_MODE=vllm
MODEL_PATH=/models/fireredasr2
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=4096
# Scheduling starting point, not a measured hardware limit.
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_QUEUED_REQS=64
ENFORCE_EAGER=0
MM_PROCESSOR_CACHE_GB=0

# Both modes expose container port 8000; use docker -p for host port mapping.
ASR_API_KEY=
STARTUP_TIMEOUT_SECONDS=900
SHUTDOWN_TIMEOUT_SECONDS=25
CHUNK_SECONDS=25
# WebRTC runs on CPU, no model download. Disable to keep all audio.
VAD_ENABLED=1
VAD_MODE=1
VAD_FRAME_MS=20
VAD_SILENCE_MS=500
VAD_PADDING_MS=200
MAX_UPLOAD_MB=256
MAX_AUDIO_SECONDS=3600
# These two limits apply only to the optional gateway.
MAX_ACTIVE_JOBS=8
BACKEND_CONCURRENCY=8
BACKEND_TIMEOUT_SECONDS=120
MAX_COMPLETION_TOKENS=512
MEDIA_TIMEOUT_SECONDS=180
